---
const WITRYNA = 'https://www.xoxobeautylab.pl';
---
<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Nie znaleziono strony — XOXO Beauty Lab</title>
<meta name="robots" content="noindex, follow">
<meta name="theme-color" content="#FAF3EC">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500&family=Jost:wght@300;400&display=swap" rel="stylesheet">
<style is:global>
:root{--cream:#FAF3EC;--ink:#1C1917;--ink-soft:#4A423B;--gold:#A6864E;--line:rgba(166,134,78,.28)}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--cream);color:var(--ink);font-family:'Jost',sans-serif;font-weight:300;
  min-height:100vh;display:flex;align-items:center;justify-content:center;padding:40px 22px;text-align:center}
img{width:170px;height:auto;margin:0 auto 34px;display:block}
h1{font-family:'Playfair Display',serif;font-weight:500;font-size:clamp(1.7rem,5vw,2.4rem);line-height:1.15}
p{color:var(--ink-soft);margin:16px auto 30px;max-width:420px;font-size:.95rem}
.akcje{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
a.btn{text-decoration:none;padding:14px 30px;font-size:.78rem;letter-spacing:.15em;text-transform:uppercase;transition:.25s}
a.ciemny{background:var(--ink);color:var(--cream)}
a.ciemny:hover{background:var(--gold)}
a.pusty{border:1px solid var(--line);color:var(--ink)}
a.pusty:hover{border-color:var(--gold)}
</style>
</head>
<body>
  <div>
    <img src="/logo.png" width="722" height="395" alt="XOXO Beauty Lab — depilacja laserowa, Złotoryja">
    <h1>Tej strony u nas nie ma</h1>
    <p>Adres jest nieaktualny albo wkradła się literówka. Wróć na stronę główną
      albo od razu wybierz termin wizyty.</p>
    <div class="akcje">
      <a class="btn ciemny" href="/">Strona główna</a>
      <a class="btn pusty" href="/rezerwacja">Umów wizytę</a>
    </div>
  </div>
</body>
</html>
