---
/* ── SEO ─────────────────────────────────────────────────────────────────
   Dane strukturalne budujemy z tego samego cennika, z ktorego dziala
   rezerwacja (src/config.js). Dzieki temu ceny i godziny pokazywane
   w Google nigdy nie rozjada sie z tym, co widzi klientka.
   ──────────────────────────────────────────────────────────────────────── */
import { KATEGORIE, GODZINY_PRACY } from '../config.js';

const WITRYNA = 'https://www.xoxobeautylab.pl';
const TYTUL = 'XOXO Beauty Lab \u2014 Depilacja laserowa Z\u0142otoryja';
const odCeny = Math.min(...KATEGORIE.find((k) => k.id === 'depilacja').zabiegi.map((z) => z.cena));
const OPIS = `Depilacja laserowa w Z\u0142otoryi \u2014 trwa\u0142e usuwanie ow\u0142osienia dla kobiet i m\u0119\u017cczyzn. Ceny od ${odCeny} z\u0142, bezp\u0142atna konsultacja. Zapisz si\u0119 online.`;

/* NAP \u2014 jedno zrodlo dla stopki, schema.org i meta tagow */
const NAP = {
  nazwa: 'XOXO Beauty Lab',
  ulica: 'ul. Cmentarna 28',
  kod: '59-500',
  miasto: 'Z\u0142otoryja',
  telefony: ['+48697061471', '+48695369875'],
  mail: 'xoxo.beautylabb@gmail.com',
  instagram: 'https://www.instagram.com/xoxo_beautylab',
  mapa: 'https://maps.google.com/?q=Cmentarna+28,+59-500+Z%C5%82otoryja',
};

/* Pytania i odpowiedzi \u2014 renderuja sie NA STRONIE i w schema FAQPage
   z tej samej tablicy, wiec nie moga sie rozjechac. */
const FAQ = [
  {
    pytanie: "Czy zabieg boli?",
    odpowiedz: "Odczucie przypomina delikatne strzyknięcie ciepłą gumką. Głowica lasera chłodzi skórę w trakcie pracy, więc zabieg jest dobrze tolerowany — najbardziej wrażliwe są okolice bikini i wąsika."
  },
  {
    pytanie: "Ile zabiegów potrzebuję?",
    odpowiedz: "Zazwyczaj 8–10, w odstępach od 4 tygodni w górę. Dokładna liczba zależy od koloru i grubości włosa oraz gospodarki hormonalnej — oceniamy to na konsultacji."
  },
  {
    pytanie: "Kiedy zobaczę pierwsze efekty?",
    odpowiedz: "Około 2 tygodnie po pierwszym zabiegu wypada 60–70% naświetlonych włosków. Nowe włoski, które pojawią się po 2–3 tygodniach, to naturalny etap cyklu wzrostu, a nie brak efektu."
  },
  {
    pytanie: "Jakie są przeciwwskazania?",
    odpowiedz: "Między innymi ciąża i karmienie piersią, świeża opalenizna, aktywne infekcje i opryszczka, choroby skóry w miejscu zabiegu, retinoidy, leki światłouczulające oraz rozrusznik serca. Pełną listę omawiamy na konsultacji i w formularzu zgody."
  },
  {
    pytanie: "Czy mężczyźni też mogą?",
    odpowiedz: "Tak. Najczęściej wykonujemy u panów kark, brodę, klatkę piersiową i plecy."
  },
  {
    pytanie: "Ile trwa depilacja laserowa?",
    odpowiedz: "Pojedynczy zabieg zajmuje od 15 minut przy wąsiku czy baczkach do około 45 minut przy całych plecach. Pachy to 25 minut, bikini głębokie 35, a uda 25. Do pierwszej wizyty doliczamy 10 minut bezpłatnej konsultacji, na której dobieramy parametry do Twojej skóry."
  },
  {
    pytanie: "Ile kosztuje depilacja laserowa?",
    odpowiedz: "Ceny pojedynczych zabiegów zaczynają się od 119 zł za wąsik, brodę lub baczki. Pachy kosztują 199 zł, bikini głębokie 299 zł, a całe plecy 299 zł. Pełny cennik znajdziesz w sekcji Cennik, a płatność odbywa się na miejscu po zabiegu."
  },
  {
    pytanie: "Czy depilacja laserowa jest trwała?",
    odpowiedz: "Po pełnej serii mieszki włosowe przestają produkować włos i efekt utrzymuje się latami. U części osób raz na rok czy dwa przydaje się pojedynczy zabieg przypominający, zwłaszcza przy zmianach hormonalnych."
  }
];

const OPISY_USLUG = {
  depilacja: 'Trwa\u0142e usuwanie ow\u0142osienia laserem w technologii SHR \u2014 dla kobiet i m\u0119\u017cczyzn, na twarzy i ciele.',
  naczynka: 'Zamykanie p\u0119kni\u0119tych naczynek i rumienia \u015bwiat\u0142em E-Light, na twarzy, szyi i dekolcie.',
  przebarwienia: 'Rozja\u015bnianie plam posl\u0142onecznych i przebarwie\u0144 hormonalnych \u015bwiat\u0142em E-Light.',
  fotoodmladzanie: 'Fotoodm\u0142adzanie \u015bwiat\u0142em szerokopasmowym SSR \u2014 poprawa kolorytu, napi\u0119cia i struktury sk\u00f3ry.',
};

const DNI_ANG = { 0:'Sunday', 1:'Monday', 2:'Tuesday', 3:'Wednesday', 4:'Thursday', 5:'Friday', 6:'Saturday' };
const dwie = (n) => String(n).padStart(2, '0');

const godzinyOtwarcia = Object.entries(GODZINY_PRACY)
  .filter(([, g]) => Array.isArray(g))
  .map(([d, [od, doK]]) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: `https://schema.org/${DNI_ANG[d]}`,
    opens: `${dwie(od)}:00`,
    closes: `${dwie(doK)}:00`,
  }));

const wszystkieCeny = KATEGORIE.flatMap((k) => k.zabiegi.map((z) => z.cena));
const widelkiCen = `${Math.min(...wszystkieCeny)}\u2013${Math.max(...wszystkieCeny)} z\u0142`;

const studio = {
  '@type': 'BeautySalon',
  '@id': `${WITRYNA}/#studio`,
  name: NAP.nazwa,
  description: OPIS,
  url: `${WITRYNA}/`,
  image: `${WITRYNA}/og.jpg`,
  logo: `${WITRYNA}/logo.png`,
  telephone: NAP.telefony[0],
  email: NAP.mail,
  address: {
    '@type': 'PostalAddress',
    streetAddress: NAP.ulica,
    postalCode: NAP.kod,
    addressLocality: NAP.miasto,
    addressRegion: 'dolno\u015bl\u0105skie',
    addressCountry: 'PL',
  },
  geo: { '@type': 'GeoCoordinates', latitude: 51.1314614, longitude: 15.9279347 },
  hasMap: NAP.mapa,
  areaServed: [
    { '@type': 'City', name: 'Z\u0142otoryja' },
    { '@type': 'AdministrativeArea', name: 'powiat z\u0142otoryjski' },
    { '@type': 'City', name: 'Legnica' },
    { '@type': 'City', name: 'Jawor' },
    { '@type': 'City', name: 'Chojn\u00f3w' },
  ],
  knowsAbout: [
    'depilacja laserowa', 'depilacja SHR', 'zamykanie naczynek',
    'usuwanie przebarwie\u0144', 'fotoodm\u0142adzanie',
  ],
  openingHoursSpecification: godzinyOtwarcia,
  priceRange: widelkiCen,
  currenciesAccepted: 'PLN',
  knowsLanguage: 'pl',
  sameAs: [NAP.instagram],
  founder: [
    { '@type': 'Person', name: 'Oliwia Bogu\u015b' },
    { '@type': 'Person', name: 'Ilona Bogu\u015b' },
  ],
  potentialAction: {
    '@type': 'ReserveAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${WITRYNA}/rezerwacja`,
      inLanguage: 'pl',
      actionPlatform: [
        'https://schema.org/DesktopWebPlatform',
        'https://schema.org/MobileWebPlatform',
      ],
    },
    result: { '@type': 'Reservation', name: 'Rezerwacja wizyty' },
  },
};

/* Osobny Service dla kazdej kategorii, z cena i czasem kazdego zabiegu */
const uslugi = KATEGORIE.map((k) => ({
  '@type': 'Service',
  '@id': `${WITRYNA}/#usluga-${k.id}`,
  name: k.nazwa,
  serviceType: k.nazwa,
  description: OPISY_USLUG[k.id],
  provider: { '@id': `${WITRYNA}/#studio` },
  areaServed: { '@type': 'City', name: 'Z\u0142otoryja' },
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: `${WITRYNA}/rezerwacja`,
    availableLanguage: 'pl',
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `${k.nazwa} \u2014 cennik`,
    itemListElement: k.zabiegi.map((z) => ({
      '@type': 'Offer',
      name: z.nazwa,
      price: String(z.cena),
      priceCurrency: 'PLN',
      availability: 'https://schema.org/InStock',
      url: `${WITRYNA}/rezerwacja`,
      itemOffered: {
        '@type': 'Service',
        name: `${z.nazwa} \u2014 ${k.nazwa}`,
        provider: { '@id': `${WITRYNA}/#studio` },
        additionalProperty: {
          '@type': 'PropertyValue',
          name: 'Czas trwania zabiegu',
          value: z.czas,
          unitCode: 'MIN',
        },
      },
    })),
  },
}));

const faqSchema = {
  '@type': 'FAQPage',
  '@id': `${WITRYNA}/#faq`,
  mainEntity: FAQ.map((f) => ({
    '@type': 'Question',
    name: f.pytanie,
    acceptedAnswer: { '@type': 'Answer', text: f.odpowiedz },
  })),
};

studio.makesOffer = uslugi.map((u) => ({
  '@type': 'Offer',
  itemOffered: { '@id': u['@id'] },
}));

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    studio,
    {
      '@type': 'WebSite',
      '@id': `${WITRYNA}/#witryna`,
      url: `${WITRYNA}/`,
      name: NAP.nazwa,
      inLanguage: 'pl-PL',
      publisher: { '@id': `${WITRYNA}/#studio` },
    },
    ...uslugi,
    faqSchema,
  ],
};

const CZCIONKI = 'https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Jost:wght@300;400;500&display=swap';
---
<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{TYTUL}</title>
<meta name="description" content={OPIS}>
<link rel="canonical" href={`${WITRYNA}/`}>
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
<meta name="theme-color" content="#FAF3EC">

<!-- Ikony -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">

<!-- Open Graph (Facebook, Messenger, WhatsApp) -->
<meta property="og:type" content="website">
<meta property="og:site_name" content={NAP.nazwa}>
<meta property="og:locale" content="pl_PL">
<meta property="og:title" content={TYTUL}>
<meta property="og:description" content={OPIS}>
<meta property="og:url" content={`${WITRYNA}/`}>
<meta property="og:image" content={`${WITRYNA}/og.jpg`}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="XOXO Beauty Lab — studio depilacji laserowej w Złotoryi">

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={TYTUL}>
<meta name="twitter:description" content={OPIS}>
<meta name="twitter:image" content={`${WITRYNA}/og.jpg`}>

<!-- Dane strukturalne: BeautySalon + 4x Service z cenami + FAQPage -->
<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>

<!-- Czcionki: nie blokuja pierwszego renderu (swap juz w URL-u) -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="image" href="/logo.png">
<link rel="preload" as="style" href={CZCIONKI}>
<link rel="stylesheet" href={CZCIONKI} media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href={CZCIONKI}></noscript>
<style is:global>
:root{
  --cream:#FAF3EC;
  --cream-deep:#F1E5D6;
  --ink:#1C1917;
  --ink-soft:#4A423B;
  --gold:#A6864E;
  --gold-light:#C9AE7C;
  --line:rgba(166,134,78,.28);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  background:var(--cream);
  color:var(--ink);
  font-family:'Jost',system-ui,sans-serif;
  font-weight:300;
  line-height:1.65;
  -webkit-font-smoothing:antialiased;
}
.wrap{max-width:1080px;margin:0 auto;padding:0 28px}
h1,h2,h3{font-family:'Playfair Display',Georgia,serif;font-weight:500;line-height:1.12}
.eyebrow{
  font-size:.7rem;letter-spacing:.32em;text-transform:uppercase;
  color:var(--gold);font-weight:400;
}

/* ---------- NAV ---------- */
nav{
  position:sticky;top:0;z-index:50;
  background:rgba(250,243,236,.92);
  backdrop-filter:blur(10px);
  border-bottom:1px solid var(--line);
}
.nav-in{display:flex;align-items:center;justify-content:space-between;height:68px}
.nav-logo{height:26px;width:auto}
.nav-links{display:flex;gap:30px;list-style:none}
.nav-links a{
  color:var(--ink-soft);text-decoration:none;font-size:.82rem;
  letter-spacing:.1em;text-transform:uppercase;transition:color .25s;
}
.nav-links a:hover{color:var(--gold)}
.nav-cta{
  background:var(--ink);color:var(--cream);text-decoration:none;
  padding:11px 24px;font-size:.75rem;letter-spacing:.14em;
  text-transform:uppercase;transition:background .25s;
}
.nav-cta:hover{background:var(--gold)}
@media(max-width:1000px){.nav-links .nav-opt{display:none}}
@media(max-width:820px){.nav-links{display:none}}

/* ---------- HERO ---------- */
header{padding:96px 0 84px;text-align:center;position:relative;overflow:hidden}
header:before{
  content:"XO";position:absolute;left:50%;top:46%;transform:translate(-50%,-50%);
  font-family:'Playfair Display',serif;font-size:34rem;line-height:1;
  color:rgba(166,134,78,.055);pointer-events:none;user-select:none;z-index:0;
}
header .wrap{position:relative;z-index:1}
.hero-logo{width:220px;height:auto;margin:0 auto 34px;display:block}
header h1{font-size:clamp(2.5rem,6.5vw,4.4rem);letter-spacing:-.015em}
header h1 em{font-style:italic;color:var(--gold);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:8px;text-decoration-color:var(--gold-light)}
.hero-sub{
  max-width:520px;margin:26px auto 0;font-size:1.03rem;color:var(--ink-soft);
}
.hero-actions{display:flex;gap:14px;justify-content:center;flex-wrap:wrap;margin-top:38px}
.btn{
  text-decoration:none;padding:15px 34px;font-size:.78rem;
  letter-spacing:.15em;text-transform:uppercase;transition:all .25s;display:inline-block;
}
.btn-dark{background:var(--ink);color:var(--cream)}
.btn-dark:hover{background:var(--gold)}
.btn-ghost{border:1px solid var(--ink);color:var(--ink)}
.btn-ghost:hover{background:var(--ink);color:var(--cream)}
.hero-meta{
  margin-top:46px;display:flex;gap:38px;justify-content:center;flex-wrap:wrap;
  font-size:.74rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);
}

/* ---------- SECTION ---------- */
section{padding:88px 0}
.sec-head{text-align:center;margin-bottom:52px}
.sec-head h2{font-size:clamp(1.9rem,4vw,2.9rem);margin-top:12px}
.sec-head p{max-width:560px;margin:18px auto 0;color:var(--ink-soft)}
.sec-head p a{color:var(--gold);text-decoration:none;border-bottom:1px solid var(--line);transition:border-color .2s}
.sec-head p a:hover{border-bottom-color:var(--gold)}

.rule{
  display:flex;align-items:center;justify-content:center;gap:12px;
  margin:0 auto;max-width:200px;
}
.rule span{flex:1;height:1px;background:var(--line)}
.rule svg{width:11px;fill:var(--gold);flex-shrink:0}

/* ---------- SIGNATURE: ŚCIEŻKA ZABIEGÓW ---------- */
.journey{background:var(--cream-deep);}
.track{position:relative;margin-top:8px;padding:30px 0 12px}
.track-line{
  position:absolute;left:0;right:0;top:94px;height:1px;background:var(--line);
}
.track-fill{
  position:absolute;left:0;top:94px;height:1px;background:var(--gold);
  width:0;transition:width 1.6s cubic-bezier(.4,0,.2,1);
}
.steps{display:flex;position:relative;gap:0}
.step{
  flex:1;text-align:center;position:relative;cursor:default;
  opacity:0;transform:translateY(14px);
  transition:opacity .5s ease,transform .5s ease;
}
.step.on{opacity:1;transform:none}
.step-pct{
  font-family:'Playfair Display',serif;font-size:1.35rem;color:var(--ink);
  height:44px;display:flex;align-items:flex-end;justify-content:center;
}
.step-dot{
  width:9px;height:9px;border-radius:50%;background:var(--cream-deep);
  border:1px solid var(--gold);margin:16px auto 0;position:relative;z-index:2;
  transition:background .3s,transform .3s;
}
.step:hover .step-dot{background:var(--gold);transform:scale(1.5)}
.step-n{
  margin-top:14px;font-size:.68rem;letter-spacing:.16em;
  text-transform:uppercase;color:var(--ink-soft);
}
.step-note{
  margin-top:6px;font-size:.72rem;color:var(--gold);
  min-height:32px;padding:0 4px;line-height:1.4;
}
@media(max-width:760px){
  .steps{flex-wrap:wrap;gap:26px 0}
  .step{flex:0 0 33.33%}
  .track-line,.track-fill{display:none}
}
.journey-foot{
  margin-top:34px;text-align:center;font-size:.9rem;color:var(--ink-soft);
  max-width:600px;margin-left:auto;margin-right:auto;
}

/* ---------- CENNIK ---------- */
.price-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 56px}
@media(max-width:760px){.price-grid{grid-template-columns:1fr;gap:0}}
.price-row{
  display:flex;align-items:baseline;justify-content:space-between;gap:14px;
  padding:15px 0;border-bottom:1px solid var(--line);
}
.price-row span:first-child{font-size:.97rem}
.price-row b{
  font-family:'Playfair Display',serif;font-weight:500;font-size:1.12rem;
  white-space:nowrap;
}
.packages{margin-top:56px;display:grid;grid-template-columns:1fr 1fr;gap:22px}
@media(max-width:760px){.packages{grid-template-columns:1fr}}
.pkg{
  border:1px solid var(--gold);padding:30px 28px;position:relative;background:var(--cream);
}
.pkg .eyebrow{display:block;margin-bottom:12px}
.pkg h3{font-size:1.22rem;line-height:1.35}
.pkg-price{
  font-family:'Playfair Display',serif;font-size:2.2rem;margin-top:16px;display:block;
}
.pkg-save{font-size:.8rem;color:var(--gold);margin-top:4px}

/* ---------- CARDS ---------- */
.cards{display:grid;grid-template-columns:1fr 1fr;gap:26px}
@media(max-width:760px){.cards{grid-template-columns:1fr}}
.card{background:var(--cream-deep);padding:36px 32px}
.card h3{font-size:1.35rem;margin-bottom:20px}
.card ul{list-style:none}
.card li{
  padding:9px 0 9px 22px;position:relative;font-size:.93rem;color:var(--ink-soft);
  border-bottom:1px solid rgba(166,134,78,.15);
}
.card li:last-child{border-bottom:0}
.card li:before{
  content:"";position:absolute;left:0;top:17px;width:6px;height:6px;
  border:1px solid var(--gold);transform:rotate(45deg);
}

/* ---------- FAQ ---------- */
.faq{max-width:760px;margin:0 auto}
details{border-bottom:1px solid var(--line)}
summary{
  padding:22px 0;cursor:pointer;list-style:none;font-size:1.03rem;
  display:flex;justify-content:space-between;align-items:center;gap:16px;
}
summary::-webkit-details-marker{display:none}
.faq summary:after{content:"+";color:var(--gold);font-size:1.35rem;transition:transform .3s}
.faq details[open] summary:after{transform:rotate(45deg)}
details p{padding:0 0 22px;color:var(--ink-soft);font-size:.95rem;max-width:92%}

/* ---------- KONTAKT ---------- */
.contact{background:var(--ink);color:var(--cream);text-align:center}
.contact h2{color:var(--cream)}
.contact .eyebrow{color:var(--gold-light)}
.contact .rule span{background:rgba(201,174,124,.3)}
.contact .rule svg{fill:var(--gold-light)}
.phones{
  display:flex;gap:14px 56px;justify-content:center;flex-wrap:wrap;margin-top:34px;
}
.phone{text-decoration:none;color:var(--cream);text-align:center}
.phone small{
  display:block;font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;
  color:var(--gold-light);margin-bottom:6px;
}
.phone span{font-family:'Playfair Display',serif;font-size:1.6rem;transition:color .25s}
.phone:hover span{color:var(--gold-light)}
.addr{margin-top:40px;font-size:.9rem;color:rgba(250,243,236,.72);line-height:1.9}

footer{
  background:var(--ink);color:rgba(250,243,236,.45);
  border-top:1px solid rgba(201,174,124,.2);
  padding:26px 0;font-size:.74rem;
}
.foot-in{display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}
footer a{color:rgba(250,243,236,.45)}

/* ---------- ZABIEGI DODATKOWE ---------- */
.svc{border:1px solid var(--line);background:var(--cream);margin-bottom:26px}
.svc summary{
  list-style:none;cursor:pointer;padding:30px 32px;
  display:flex;align-items:center;justify-content:space-between;gap:18px;
}
.svc summary::-webkit-details-marker{display:none}
.svc-t h3{font-size:1.45rem;margin-bottom:6px;display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.tech{
  font-family:'Jost',sans-serif;font-weight:500;font-size:.6rem;
  letter-spacing:.2em;text-transform:uppercase;color:var(--gold);
  border:1px solid var(--gold);padding:4px 9px;white-space:nowrap;
}
.svc-t p{font-size:.9rem;color:var(--ink-soft);max-width:560px}
.svc-toggle{
  flex-shrink:0;width:38px;height:38px;border:1px solid var(--gold);
  display:flex;align-items:center;justify-content:center;
  color:var(--gold);font-size:1.3rem;font-weight:300;transition:all .3s;
}
details[open] .svc-toggle{background:var(--gold);color:var(--cream);transform:rotate(45deg)}
.svc-body{padding:0 32px 34px}
.svc-desc{
  display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;
  padding:22px 0 26px;border-top:1px solid var(--line);
}
@media(max-width:760px){.svc-desc{grid-template-columns:1fr}}
.svc-desc h4{
  font-family:'Jost',sans-serif;font-weight:500;font-size:.72rem;
  letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin-bottom:8px;
}
.svc-desc p{font-size:.88rem;color:var(--ink-soft)}
.svc-prices{display:grid;grid-template-columns:1fr 1fr;gap:0 44px}
@media(max-width:760px){.svc-prices{grid-template-columns:1fr}}
.svc-note{margin-top:18px;font-size:.8rem;color:var(--gold);font-style:italic}
.badge-main{
  display:inline-block;background:var(--gold);color:var(--cream);
  font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;
  padding:4px 10px;margin-bottom:12px;
}
.ig-link{display:inline-flex;align-items:center;gap:9px;text-decoration:none}
.ig-link svg{width:19px;height:19px}

/* ---------- REVEAL ---------- */
.rv{opacity:0;transform:translateY(20px);transition:opacity .7s ease,transform .7s ease}
.rv.on{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){
  *{transition:none!important;animation:none!important}
  .rv,.step{opacity:1;transform:none}
}
:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
::selection{background:var(--gold);color:var(--cream)}
.btn,.nav-cta{border-radius:1px}
.pkg{transition:transform .3s ease,box-shadow .3s ease}
.pkg:hover{transform:translateY(-4px);box-shadow:0 14px 34px rgba(28,25,23,.08)}
.price-row{transition:padding-left .25s ease}
.price-row:hover{padding-left:8px}
</style>
</head>
