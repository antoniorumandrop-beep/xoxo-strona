# Skopiuj do .env (lokalnie) albo wklej w Vercel → Settings → Environment Variables.
# .env NIGDY nie trafia do gita.

# Cała zawartość pliku JSON z kluczem Service Account — w jednej linii.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"rezerwacje@....iam.gserviceaccount.com","client_id":"..."}

# ID kalendarza Google (adres e-mail kalendarza).
GOOGLE_CALENDAR_ID=xoxo.beautylabb@gmail.com

# Klucz z resend.com → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Opcjonalne — mają sensowne wartości domyślne:
# Nadawca maili. Domena musi być zweryfikowana w Resend.
RESEND_FROM=XOXO Beauty Lab <rezerwacje@xoxobeautylab.pl>
# Adres, na który przychodzą powiadomienia o nowych rezerwacjach.
STUDIO_EMAIL=xoxo.beautylabb@gmail.com
